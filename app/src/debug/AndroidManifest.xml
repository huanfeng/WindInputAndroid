<?xml version="1.0" encoding="utf-8"?>
<!-- 只进 debug 包的清单（与 main 合并）。
     输入测试台在正式包里不导出；模拟器自动化测试（scripts/emu-test.sh）要从 shell 用 am start
     拉起它，shell 不能启动未导出的 Activity，所以只在 debug 包里改成导出。e2e 装的就是 debug 包 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".settings.TestPadActivity"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
