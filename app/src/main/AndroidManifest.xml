<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按键振动强度可调：系统 performHapticFeedback 的强度定死，要自己调振动器（KeyHaptics） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".WindInputApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WindInput">

        <!-- 输入法服务：Android IME 框架对接点 -->
        <service
            android:name=".service.WindInputImeService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 输入测试台：模拟器自动化测试用（scripts/emu-test.ps1） -->
        <activity
            android:name=".settings.TestPadActivity"
            android:exported="true"
            android:label="输入测试台"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 设置入口（Compose，miuix 风格）。只在这里开预测性返回：侧滑时页面跟手；
             不放在 application 上，免得改变输入法服务自己的返回键处理 -->
        <activity
            android:name=".settings.SettingsActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
